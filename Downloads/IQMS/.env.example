# ============================================================
#  AQIMS — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=changeme-use-a-long-random-string-here
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aqims_db
DB_USER=aqims_user
DB_PASSWORD=changeme_db_password

# --- InfluxDB ---
INFLUX_HOST=http://influxdb:8086
INFLUX_ORG=aqims
INFLUX_BUCKET=air_quality
INFLUX_TOKEN=changeme_influx_token
INFLUX_USER=admin
INFLUX_PASSWORD=changeme_influx_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# --- MQTT (EMQX) ---
MQTT_HOST=emqx
MQTT_PORT=8883
MQTT_USERNAME=backend_service
MQTT_PASSWORD=changeme_mqtt_password
MQTT_CA_CERT=/app/certs/ca.crt
MQTT_CLIENT_CERT=/app/certs/client.crt
MQTT_CLIENT_KEY=/app/certs/client.key

# --- JWT ---
JWT_SECRET_KEY=changeme-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (alertes) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@aqims.local

# --- FOTA ---
FOTA_SERVER_URL=https://aqims.local/fota
FOTA_SECRET_KEY=changeme_fota_secret
